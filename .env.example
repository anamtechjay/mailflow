# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Do NOT commit real secrets.

# --- Entra app identity (Microsoft Entra ID -> App registrations) ---
GRAPH_TENANT_ID=            # Entra Overview -> Tenant ID (GUID)
GRAPH_TENANT_DOMAIN=        # Entra Overview -> primary domain (e.g. yourtenant.onmicrosoft.com)
GRAPH_CLIENT_ID=            # App registration -> Application (client) ID
GRAPH_CLIENT_SECRET=        # App registration -> Certificates & secrets -> secret VALUE
GRAPH_MAILBOXES=            # comma-separated mailbox UPNs to watch (e.g. ops@yourtenant.onmicrosoft.com)

# --- Azure Event Hubs (already created) ---
EVENTHUB_NAMESPACE=mailflow
EVENTHUB_HUB=graph-notifications
EVENTHUB_CONSUMER_GROUP=mailflow
EVENTHUB_CONNECTION_STRING=   # namespace -> Shared access policies -> RootManageSharedAccessKey -> Connection string-primary key

# --- Checkpoint storage (Step 9 - create next) ---
CHECKPOINT_CONNECTION_STRING=  # storage account -> Access keys -> Connection string
CHECKPOINT_CONTAINER=eh-checkpoints

# --- Cost tracking (optional) ---
AZURE_SUBSCRIPTION_ID=23c5d2df-2bed-476e-8f7d-2729e8732f6d

# ============================================================================
# Gmail provider (alternative to Graph) — see docs/google-setup-step-by-step.md
# ============================================================================
GMAIL_CLIENT_ID=             # OAuth client ID (Desktop app)
GMAIL_CLIENT_SECRET=         # OAuth client secret
GMAIL_REFRESH_TOKEN=         # per-user refresh token (gmail.readonly)
GMAIL_MAILBOXES=             # your@gmail.com (or "me")
PUBSUB_PROJECT_ID=           # GCP project id
PUBSUB_TOPIC=gmail-notifications
PUBSUB_SUBSCRIPTION=mailflow
CLEAN_EMAILS_TOPIC=clean-emails    # mailflow publishes each CleanEmail here; your app subscribes
